#!/usr/bin/env bash
# lemux — a tmux-native, node-based navigator for branched Claude Code sessions.
# Branch from a highlighted excerpt, wander deep, jump around, delete side quests.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
LEMUX_DIR="${LEMUX_DIR:-$HOME/.lemux}"
TREE="$LEMUX_DIR/tree.json"
CLAUDE_BIN="${LEMUX_CLAUDE:-$(command -v claude || echo "$HOME/.local/bin/claude")}"
CLAUDE_PROJECTS="$HOME/.claude/projects"

# ---------- helpers ----------

die() {
  echo "lemux: $*" >&2
  [[ -n "${TMUX:-}" ]] && tmux display-message "lemux: $*" || true
  exit 1
}

init_state() {
  mkdir -p "$LEMUX_DIR"
  [[ -f "$TREE" ]] || echo '[]' >"$TREE"
}

munge() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

new_uuid() { uuidgen | tr '[:upper:]' '[:lower:]'; }

jq_update() {
  local tmp
  tmp=$(mktemp "$LEMUX_DIR/.tree.XXXXXX")
  jq "$@" "$TREE" >"$tmp" && mv "$tmp" "$TREE"
}

node_field() { jq -r --arg id "$1" ".[] | select(.id==\$id) | .$2 // \"\"" "$TREE"; }

# The session a side quest ultimately hangs off — the navigator's scope.
root_of() {
  local id="$1" p
  while p=$(node_field "$id" parent); [[ -n "$p" ]]; do id="$p"; done
  printf '%s' "$id"
}

# Enforce the path discipline: in the topic containing ctx, close every
# window that isn't on the chain root → anchor, and clear the pruned nodes'
# window records. skip's window is left for tmux to close naturally (it's
# the caller's own). An empty anchor prunes the whole topic.
prune_path() { # ctx anchor [skip]
  local ctx="$1" anchor="$2" skip="${3:-}" keep=" " n win pruned=""
  n="$anchor"; while [[ -n "$n" ]]; do keep+="$n "; n=$(node_field "$n" parent); done
  for n in $(descendants "$(root_of "$ctx")"); do
    [[ "$keep" == *" $n "* ]] && continue
    win=$(node_field "$n" window)
    if [[ "$n" != "$skip" ]] && window_alive "$win"; then
      [[ "$(state_of "$n")" != "idle" ]] && continue   # working or waiting on you — spared
      tmux kill-window -t "$win" 2>/dev/null || true
    fi
    pruned+="$n"$'\n'
  done
  [[ -z "$pruned" ]] && return 0
  jq_update --argjson ids "$(printf '%s' "$pruned" | jq -R . | jq -s .)" \
    'map(if (.id as $i | $ids | index($i)) then .window="" | .pane="" else . end)'
}

descendants() { # id — print the id and every descendant id, one per line (BFS)
  local frontier=("$1") next p kids
  printf '%s\n' "$1"
  while ((${#frontier[@]})); do
    next=()
    for p in "${frontier[@]}"; do
      kids=($(jq -r --arg id "$p" '.[] | select(.parent==$id) | .id' "$TREE"))
      ((${#kids[@]})) && { printf '%s\n' "${kids[@]}"; next+=("${kids[@]}"); }
    done
    frontier=("${next[@]:-}")
    [[ -z "${frontier[0]:-}" ]] && frontier=()
  done
}

add_node() { # id parent name excerpt dir [question]
  jq_update --arg id "$1" --arg parent "$2" --arg name "$3" \
    --arg excerpt "$4" --arg dir "$5" --arg question "${6:-}" \
    --argjson created "$(date +%s)" \
    '. + [{id:$id, parent:$parent, name:$name, excerpt:$excerpt, question:$question,
           dir:$dir, created:$created, window:"", pane:""}]'
}

window_alive() {
  [[ -n "$1" ]] && tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx "$1"
}

# Focus a window even when it lives in another tmux session: make it that
# session's current window, then bring the client over to it.
focus_window() {
  tmux select-window -t "$1" 2>/dev/null || return 0
  tmux switch-client -t "$1" 2>/dev/null || true
}

# Session state, ground truth from Claude Code's own lifecycle hooks
# (injected at launch via --settings): busy while a turn is running,
# waiting at a permission/elicitation dialog, idle between turns.
# No state file (pre-hook session) reads as idle.
state_of() { cat "$LEMUX_DIR/state/$1" 2>/dev/null || echo idle; }

ago() { # epoch → "5m ago"
  local d=$(($(date +%s) - $1))
  if ((d < 60)); then echo "${d}s ago"
  elif ((d < 3600)); then echo "$((d / 60))m ago"
  elif ((d < 86400)); then echo "$((d / 3600))h ago"
  else echo "$((d / 86400))d ago"; fi
}

hook_block() { # the lifecycle hooks JSON — shared by hooks.json and `lemux enable`
  jq -n --arg s "$(printf '%q' "$SELF")" '{
    SessionStart:      [{hooks: [{type: "command", command: ($s + " _hello")}]}],
    UserPromptSubmit:  [{hooks: [{type: "command", command: ($s + " _state busy")}]}],
    PreToolUse:        [{hooks: [{type: "command", command: ($s + " _state busy")}]}],
    PermissionRequest: [{hooks: [{type: "command", command: ($s + " _state waiting")}]}],
    Elicitation:       [{hooks: [{type: "command", command: ($s + " _state waiting")}]}],
    Stop:              [{hooks: [{type: "command", command: ($s + " _state idle")}]}],
    StopFailure:       [{hooks: [{type: "command", command: ($s + " _state idle")}]}],
    SessionEnd:        [{hooks: [{type: "command", command: ($s + " _state gone")}]}]
  }'
}

ensure_hooks() { # write the per-launch settings that report state back to us
  jq -n --argjson h "$(hook_block)" '{hooks: $h}' >"$LEMUX_DIR/hooks.json"
}

cmd_enable() { # merge the hooks into ~/.claude/settings.json so ANY claude session
  # in tmux tags its pane — plain claude, --continue, --resume, all branchable.
  local settings="$HOME/.claude/settings.json" tmp
  mkdir -p "$HOME/.claude"
  [[ -s "$settings" ]] || echo '{}' >"$settings"
  tmp=$(mktemp "$HOME/.claude/.settings.XXXXXX")
  jq --argjson ours "$(hook_block)" '
    def scrubbed: map(select([.hooks[]?.command // ""]
      | any(test("lemux\\S* _(hello|state)")) | not));
    .hooks = ((.hooks // {}) as $h
      | $h + ($ours | with_entries(.value = ((($h[.key] // []) | scrubbed) + .value))))
  ' "$settings" >"$tmp" && mv "$tmp" "$settings"
  echo "lemux: hooks merged into $settings — claude sessions in tmux are now branchable (restart any already running)"
}

cmd__state() { # <state> — hook callback; session_id arrives on stdin as JSON
  local s="${1:?}" sid
  sid=$(jq -r '.session_id // ""' 2>/dev/null) || sid=""
  [[ -n "$sid" ]] || exit 0
  mkdir -p "$LEMUX_DIR/state"
  if [[ "$s" == "gone" ]]; then
    rm -f "$LEMUX_DIR/state/$sid"
  else
    printf '%s' "$s" >"$LEMUX_DIR/state/$sid"
  fi
}

cmd__hello() { # SessionStart hook: mark idle and tag the pane, so every claude
  # session in tmux — however it was started — is branchable. Re-fires on
  # /clear and resume, so the tag always names the session actually running.
  init_state
  local json sid cwd
  json=$(cat 2>/dev/null || true)
  sid=$(jq -r '.session_id // ""' <<<"$json" 2>/dev/null) || sid=""
  [[ -n "$sid" ]] || exit 0
  mkdir -p "$LEMUX_DIR/state"
  printf 'idle' >"$LEMUX_DIR/state/$sid"
  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit 0
  cwd=$(jq -r '.cwd // ""' <<<"$json" 2>/dev/null) || cwd=""
  tmux set-option -p -t "$TMUX_PANE" @lemux_session "$sid" 2>/dev/null || true
  [[ -z "$cwd" ]] || tmux set-option -p -t "$TMUX_PANE" @lemux_dir "$cwd" 2>/dev/null || true
  # a known node resumed by hand (claude --resume) — reattach it to this window
  if [[ -n "$(node_field "$sid" name)" ]]; then
    jq_update --arg id "$sid" \
      --arg win "$(tmux display-message -t "$TMUX_PANE" -p '#{window_id}')" \
      --arg pane "$TMUX_PANE" \
      'map(if .id==$id then .window=$win | .pane=$pane else . end)'
  fi
}

session_file() { # id dir
  printf '%s/%s/%s.jsonl' "$CLAUDE_PROJECTS" "$(munge "$2")" "$1"
}

collapse_ws() { tr '\n\t\r' '   ' | sed -E 's/ +/ /g; s/^ //; s/ $//'; }

# Whatever the user last selected: system clipboard first (macOS mouse
# selection + cmd-C), then tmux's own paste buffer (tmux copy-mode / mouse).
get_clip() {
  local t=""
  if command -v pbpaste >/dev/null 2>&1; then t=$(pbpaste 2>/dev/null || true); fi
  if [[ -z "${t//[[:space:]]/}" ]]; then t=$(tmux show-buffer 2>/dev/null || true); fi
  printf '%s' "$t"
}

# die, but visibly — inside a popup, stderr vanishes the instant we exit.
popup_die() {
  printf '\n  \033[1mlemux:\033[0m %s\n\n  press any key…' "$*"
  read -n 1 -s -r </dev/tty 2>/dev/null || sleep 3
  exit 1
}

# Type text into a freshly spawned claude pane once its UI has rendered.
# The typist is handed to the tmux server so it outlives us — we're usually
# a popup that closes the moment this returns. The text goes via a file so
# tmux's format expansion can't mangle a '#' in the excerpt.
_prefill() { # pane text submit(0|1)
  local pane="$1" text="$2" submit="$3" f
  f=$(mktemp "$LEMUX_DIR/.seed.XXXXXX")
  printf '%s' "$text" >"$f"
  tmux run-shell -b "$(printf '%q' "$SELF") _type $(printf '%q' "$pane") $(printf '%q' "$f") $submit"
}

cmd__type() { # pane seedfile submit — wait for claude's input box, then type
  local pane="$1" seedfile="$2" submit="$3" i out text
  text=$(cat "$seedfile" 2>/dev/null || true)
  rm -f "$seedfile"
  [[ -n "$text" ]] || return 0
  for i in $(seq 1 120); do
    sleep 0.25
    out=$(tmux capture-pane -p -t "$pane" 2>/dev/null || true)
    case "$out" in *"for shortcuts"*) break ;; esac
  done
  sleep 0.8
  tmux send-keys -t "$pane" -l -- "$text" 2>/dev/null || true
  if [[ "$submit" == 1 ]]; then
    sleep 0.5
    tmux send-keys -t "$pane" Enter 2>/dev/null || true
  fi
}

cmd__name() { # id promptfile — background: haiku writes the branch brief {name, diverge}
  local id="$1" f="$2" out name diverge win sys
  # bash 3.2 scans this whole $(…) naively, counting quotes even inside the
  # heredoc — keep its apostrophes paired or the sed backticks below misparse
  sys=$(cat <<'PROMPT'
A side quest is being branched off a parent AI conversation. The user highlighted a passage of the assistant's message and/or typed a question, steering the exploration somewhere new. You write the branch's brief.

Your entire reply is one raw JSON object — it starts with { and ends with }, no fences, no commentary:
{"name": "...", "diverge": "..."}

"name" — a 1-4 word lowercase name for the branch's tmux window.

"diverge" — ONE sentence, lowercase, no trailing period, 10-18 words, stating where this new exploration is heading. It opens with a motion verb chosen by the kind of move the user is making:
- doubting or stress-testing a claim → testing, probing, pressure-testing
- asking how or why something works → tracing, unpacking, untangling
- comparing options → weighing, pitting ... against ...
- drilling into a term or detail → digging into, zooming in on, pinning down
- sizing or benchmarking something → measuring, quantifying, simulating
- wandering to a related topic → peeling off to, chasing, circling back to

Rules:
- the sentence must read as natural english after its opening verb
- the highlight and question choose the destination: resolve what the highlighted phrase refers to and make that — asked about the way the user asked about it — your sentence's subject; no code or formulas
- the rest of the assistant response only exists to decode references; a topic it covers that the highlight and question do not touch must not appear in your sentence
- the sentence must stand alone: the user re-reads it days later without the conversation, so spell the referent out in plain words — never echo a bare heading or shorthand like "the split" or "this part" whose meaning lives in the parent conversation
- forward-looking: the direction of travel, never a summary of what the assistant already said
- if the input lists earlier steps of this exploration, your sentence CONTINUES that story like the next storyteller in a relay — never restate an earlier step and never reuse its opening verb

Examples of good diverge lines (each from a different conversation):
- digging into how ramjet aircraft get off the ground when the engine is dead at standstill
- weighing eventual consistency against the strict ordering the checkout flow quietly assumes
- a continuation: after "untangling why the borrow checker rejects the iterator rewrite", the next branch wrote: chasing lifetime annotations that could convince it — or a restructure that sidesteps them
PROMPT
)
  out=$("$CLAUDE_BIN" -p --model claude-haiku-4-5 \
    --system-prompt "$sys" \
    --tools "" --strict-mcp-config --max-turns 1 \
    --setting-sources "" --no-session-persistence <"$f" 2>/dev/null |
    sed 's/^```.*$//' | jq -c 'select(type=="object")' 2>/dev/null | head -1) || out=""
  rm -f "$f"
  name=$(jq -r '.name // ""' <<<"$out" 2>/dev/null | tr -cd '[:alnum:] -' |
    awk '{for(i=1;i<=NF&&i<=4;i++)printf "%s%s",(i>1?" ":""),$i}') || name=""
  diverge=$(jq -r '.diverge // ""' <<<"$out" 2>/dev/null | collapse_ws | cut -c1-220) || diverge=""
  [[ -n "$name$diverge" ]] || return 0   # anything went wrong — the placeholder name stays
  jq_update --arg id "$id" --arg n "$name" --arg d "$diverge" \
    'map(if .id==$id then ((if $n=="" then . else .name=$n end) + {diverge:$d}) else . end)'
  [[ -n "$name" ]] || return 0
  win=$(node_field "$id" window)
  window_alive "$win" && tmux rename-window -t "$win" "$name" 2>/dev/null || true
}

# ---------- commands ----------

pane_session() { # pane — the claude session id its hooks reported
  tmux display-message -t "$1" -p '#{@lemux_session}' 2>/dev/null || true
}

pane_dir() { # pane — where the pane's claude session lives
  tmux display-message -t "$1" -p '#{@lemux_dir}' 2>/dev/null || true
}

adopt_root() { # id pane — a session's first branch declares it a topic root in
  # ~/.lemux, named after its folder. This is the only way roots come to exist.
  local id="$1" pane="$2" dir
  dir=$(pane_dir "$pane")
  [[ -n "$dir" ]] || dir=$(tmux display-message -t "$pane" -p '#{pane_current_path}' 2>/dev/null || true)
  [[ -n "$dir" ]] || return 1
  add_node "$id" "" "$(basename "$dir")" "" "$dir"
  jq_update --arg id "$id" \
    --arg win "$(tmux display-message -t "$pane" -p '#{window_id}')" --arg pane "$pane" \
    'map(if .id==$id then .window=$win | .pane=$pane else . end)'
}

cmd_branch() { # <pane_id> [--text <excerpt>] [--ask <question>] — fork the pane's session
  init_state
  local pane excerpt="" question=""
  pane="${1:?usage: lemux branch <pane_id> [--text <excerpt>] [--ask <question>]}"
  shift
  while (($#)); do
    case "$1" in
      --text) shift; excerpt=$(printf '%s' "${1:-}" | collapse_ws) ;;
      --ask)  shift; question=$(printf '%s' "${1:-}" | collapse_ws) ;;
      *)      die "branch: unexpected argument: $1" ;;
    esac
    shift
  done
  [[ -n "$excerpt$question" ]] || die "nothing to branch on — select some text and copy it first"

  local parent dir id name
  parent=$(pane_session "$pane")
  [[ -n "$parent" ]] || die "no claude session in this pane — is one running? (new setup: lemux enable, then restart claude)"
  dir=$(node_field "$parent" dir)
  if [[ -z "$dir" ]]; then
    # plain claude session (started without lemux) — its first branch enrols it
    adopt_root "$parent" "$pane" || die "cannot tell where this session lives — restart claude and retry"
    dir=$(node_field "$parent" dir)
  fi
  [[ -f "$(session_file "$parent" "$dir")" ]] || die "nothing to branch yet — send at least one message first"

  id=$(new_uuid)
  name=$(printf '%s' "${question:-$excerpt}" | cut -c1-28 | tr -cd '[:print:]' | sed -E 's/^ +| +$//g')
  [[ -n "$name" ]] || name="branch"
  add_node "$id" "$parent" "$name" "$excerpt" "$dir" "$question"

  local newpane
  newpane=$(tmux new-window -c "$dir" -n "$name" -P -F '#{pane_id}' \
    "exec $(printf '%q' "$SELF") _run $(printf '%q' "$id") $(printf '%q' "$dir") fork $(printf '%q' "$parent")")

  # Seed the fork's input box. With a question we submit it; without one we
  # leave the excerpt sitting there for you to type after.
  local seed submit
  if [[ -n "$excerpt" ]]; then
    seed="Re \"$(printf '%s' "$excerpt" | cut -c1-600)\": $question"
  else
    seed="$question"
  fi
  [[ -n "$question" ]] && submit=1 || submit=0
  _prefill "$newpane" "$seed" "$submit"

  # Brief the branch in the background: haiku reads the excerpt plus the
  # assistant message it was highlighted from (empty excerpt matches the last
  # message) and writes {name, diverge} onto the node — written once, never
  # updated, so the preview stands alone however the session evolves. For
  # deeper branches the ancestors' diverge lines ride along so each new line
  # continues the story instead of restarting it.
  local ctx f chain="" n line
  ctx=$(jq -rs --arg ex "$excerpt" '
    [ .[] | select(.type=="assistant") | (.message.content // "")
      | (if type=="string" then .
         else ([.[]? | select(.type?=="text") | .text] | join(" ")) end)
      | gsub("\\s+"; " ") | select(. != "") ]
    | (map(select(contains($ex))) | last) // last // ""
  ' "$(session_file "$parent" "$dir")" 2>/dev/null | cut -c1-2400) || ctx=""
  n="$parent"
  while [[ -n "$n" ]]; do
    line=$(node_field "$n" diverge)
    [[ -z "$line" ]] || chain="- $line"$'\n'"$chain"
    n=$(node_field "$n" parent)
  done
  # stash the highlight's surroundings so the preview can show it in place
  local pre="" post=""
  if [[ -n "$excerpt" && "$ctx" == *"$excerpt"* ]]; then
    pre="${ctx%%"$excerpt"*}"
    post="${ctx#*"$excerpt"}"
    ((${#pre} <= 150)) || pre="…${pre:$((${#pre} - 150))}"
    ((${#post} <= 150)) || post="${post:0:150}…"
    jq_update --arg id "$id" --arg pre "$pre" --arg post "$post" \
      'map(if .id==$id then . + {ctx_pre:$pre, ctx_post:$post} else . end)'
  fi
  f=$(mktemp "$LEMUX_DIR/.name.XXXXXX")
  {
    printf 'A side quest is being branched from this assistant response:\n"%s"\n' "$ctx"
    [[ -z "$excerpt" ]] || printf 'The user highlighted: "%s"\n' "$excerpt"
    [[ -z "$question" ]] || printf 'Their question: "%s"\n' "$question"
    [[ -z "$chain" ]] || printf 'Earlier steps of this exploration, oldest first:\n%s' "$chain"
  } >"$f"
  tmux run-shell -b "$(printf '%q' "$SELF") _name $(printf '%q' "$id") $(printf '%q' "$f")"
}

cmd_ask() { # <pane_id> — popup: confirm the copied excerpt, type a question, branch
  init_state
  local pane="${1:?usage: lemux ask <pane_id>}" parent dir excerpt question shown
  parent=$(pane_session "$pane")
  [[ -n "$parent" ]] || popup_die "no claude session in this pane — new setup? run: lemux enable, then restart claude"
  dir=$(node_field "$parent" dir)
  [[ -n "$dir" ]] || dir=$(pane_dir "$pane")
  [[ -n "$dir" ]] || popup_die "cannot tell where this session lives — restart claude and retry"
  [[ -f "$(session_file "$parent" "$dir")" ]] || popup_die "nothing to branch yet — send at least one message first"

  excerpt=$(get_clip | collapse_ws)
  local hdr rc=0 from
  from=$(node_field "$parent" name)
  [[ -n "$from" ]] || from=$(basename "$dir")
  hdr="branch a side quest  (from $from)"$'\n'
  if [[ -n "$excerpt" ]]; then
    shown=$(printf '%s' "$excerpt" | cut -c1-240)
    [[ "${#excerpt}" -gt 240 ]] && shown="$shown…"
    hdr+="on \"$shown\""$'\n'
  else
    hdr+="nothing copied — the branch will start from your question alone"$'\n'
  fi
  hdr+="type a question · enter: branch (empty: type in the branch) · esc: cancel"
  # fzf as the line editor: real editing keys, and esc/ctrl-c cancel cleanly
  # (bash 3.2's read -e can do neither).
  question=$(: | fzf --print-query --prompt '> ' --layout=reverse --no-info \
    --header "$hdr") || rc=$?
  ((rc == 130)) && return 0
  cmd_branch "$pane" --text "$excerpt" --ask "$question"
}

cmd__popup() { # <width> <height> <subcommand> <pane_id> — called from the tmux bindings
  tmux display-popup -E -w "${1:?}" -h "${2:?}" \
    "$(printf '%q' "$SELF") ${3:?} $(printf '%q' "${4:?}")"
}

cmd__run() { # id dir mode [parent] — wrapper that tags the pane and execs claude
  local id="$1" dir="$2" mode="$3" parent="${4:-}"
  cd "$dir"
  tmux set-option -p @lemux_session "$id"
  tmux set-option -p remain-on-exit failed 2>/dev/null || true
  jq_update --arg id "$id" \
    --arg win "$(tmux display-message -p '#{window_id}')" \
    --arg pane "${TMUX_PANE:-}" \
    'map(if .id==$id then .window=$win | .pane=$pane else . end)'
  local args rc=0
  case "$mode" in
    fork)   args=(--resume "$parent" --fork-session --session-id "$id") ;;
    revive) args=(--resume "$id") ;;
    *)      die "unknown run mode: $mode" ;;
  esac
  ensure_hooks
  "$CLAUDE_BIN" --settings "$LEMUX_DIR/hooks.json" "${args[@]}" || rc=$?
  rm -f "$LEMUX_DIR/state/$id"
  # 130 is ctrl-c — a normal way to leave. Anything else keeps the pane
  # (remain-on-exit) so the error stays readable.
  ((rc)) && ((rc != 130)) && exit "$rc"

  # Exiting walks you back up the path: land on the parent, close every
  # window in the topic below it. State and transcripts survive — the
  # tree revives any of it.
  local p win
  p=$(node_field "$id" parent)
  prune_path "$id" "$p" "$id"
  tmux set-option -p -u @lemux_session 2>/dev/null || true
  if [[ -n "$p" ]]; then
    win=$(node_field "$p" window)
    window_alive "$win" && focus_window "$win" || true
  fi
}

cmd__list() { # <root_id> — tab-separated: id <TAB> rendered tree line
  init_state
  _walk "${1:?}" "" root
}

_walk() { # id prefix position(root|mid|last)
  local id="$1" prefix="$2" pos="$3" glyph=""
  local child_prefix="$prefix"
  case "$pos" in
    mid)  glyph="├─ "; child_prefix="${prefix}│  " ;;
    last) glyph="└─ "; child_prefix="${prefix}   " ;;
  esac
  local status="○"
  window_alive "$(node_field "$id" window)" && status="●"
  printf '%s\t%s%s%s %s\n' "$id" "$prefix" "$glyph" "$status" "$(node_field "$id" name)"
  local kids i n
  kids=($(jq -r --arg id "$id" '[.[] | select(.parent==$id)] | sort_by(.created) | .[].id' "$TREE"))
  n=${#kids[@]}
  for ((i = 0; i < n; i++)); do
    if ((i == n - 1)); then _walk "${kids[$i]}" "$child_prefix" last
    else _walk "${kids[$i]}" "$child_prefix" mid; fi
  done
}

cmd_tree() { # <pane_id> — fzf navigator over this session's own side quests
  init_state
  local pane="${1:?usage: lemux tree <pane_id>}" cur root self out
  cur=$(pane_session "$pane")
  [[ -n "$cur" ]] || popup_die "no claude session in this pane — new setup? run: lemux enable, then restart claude"
  root=$(root_of "$cur")
  [[ -n "$(node_field "$root" name)" ]] || popup_die "no side quests yet — copy some text and branch with prefix+B first"
  self=$(printf '%q' "$SELF")
  out=$(cmd__list "$root" | fzf --delimiter='\t' --with-nth=2 --no-sort --layout=reverse \
    --prompt='lemux> ' \
    --header='enter: jump · ctrl-x: delete branch · esc: close' \
    --preview="$self _preview {1}" --wrap-sign='  ' \
    --preview-window=right,55%,wrap,border-left \
    --bind="ctrl-x:execute-silent($self rm {1})+reload($self _list $root)") || return 0
  cmd_jump "${out%%$'\t'*}"
}

cmd_jump() { # id — focus the branch's window, reviving it if closed
  local id="${1:?usage: lemux jump <id>}" win
  win=$(node_field "$id" window)
  if window_alive "$win"; then
    focus_window "$win"
  else
    local dir name
    dir=$(node_field "$id" dir)
    name=$(node_field "$id" name)
    [[ -n "$dir" ]] || die "unknown session $id"
    tmux new-window -c "$dir" -n "$name" \
      "exec $(printf '%q' "$SELF") _run $(printf '%q' "$id") $(printf '%q' "$dir") revive"
  fi
  # Landing somewhere means that's the path now — close everything below it.
  prune_path "$id" "$id"
}

cmd_rm() { # <topic-name | id> | --pane <pane_id> — delete a branch or untrack a topic
  init_state
  local id=""
  while (($#)); do
    case "$1" in
      --pane) shift; id=$(pane_session "${1:?}") ;;
      *)      id="$1" ;;
    esac
    shift
  done
  [[ -n "$id" ]] || die "usage: lemux rm <topic-name | id | --pane <pane_id>>"
  if [[ -z "$(node_field "$id" name)" ]]; then
    # not an id — resolve it as a topic name in this folder
    local matches
    matches=($(jq -r --arg n "$id" --arg d "$PWD" \
      '.[] | select(.parent=="" and .name==$n and .dir==$d) | .id' "$TREE"))
    case ${#matches[@]} in
      0) die "no topic named '$id' in this folder (topics are per-folder, like claude --resume)" ;;
      1) id="${matches[0]}" ;;
      *) die "several topics here are named '$id' — rm by id: ${matches[*]}" ;;
    esac
  fi

  local ids n root_parent
  ids=($(descendants "$id"))
  root_parent=$(node_field "$id" parent)
  for n in "${ids[@]}"; do
    local win dir
    win=$(node_field "$n" window)
    window_alive "$win" && tmux kill-window -t "$win" 2>/dev/null || true
    rm -f "$LEMUX_DIR/state/$n"
    # Root transcripts are never auto-deleted; branch transcripts are.
    if ! { [[ "$n" == "$id" ]] && [[ -z "$root_parent" ]]; }; then
      dir=$(node_field "$n" dir)
      rm -f "$(session_file "$n" "$dir")"
    fi
  done
  local json_ids
  json_ids=$(printf '%s\n' "${ids[@]}" | jq -R . | jq -s .)
  jq_update --argjson dead "$json_ids" 'map(select(.id as $i | $dead | index($i) | not))'
}

pwrap() { # firstprefix contprefix viswidth text — fold to the preview width with a hanging indent
  local fp="$1" cp="$2" vis="$3" text="$4" body
  body=$((${FZF_PREVIEW_COLUMNS:-72} - vis)); ((body >= 20)) || body=20
  printf '%s' "$text" | fold -s -w "$body" | awk -v fp="$fp" -v cp="$cp" -v rs=$'\033[0m' \
    '{sub(/ +$/, ""); print (NR==1 ? fp : cp) $0 rs}'
}

psnippet() { # pre excerpt post — the assistant text with the highlighted span marked, wrapped
  local body
  body=$((${FZF_PREVIEW_COLUMNS:-72} - 2)); ((body >= 20)) || body=20
  printf '%s\001%s\002%s' "$1" "$2" "$3" | fold -s -w "$body" | awk \
    -v fp=$'\033[33m❝\033[0m ' -v ci='  ' -v dim=$'\033[2m' -v hl=$'\033[30;43m' -v rs=$'\033[0m' '
    BEGIN { mode = 0 }
    {
      sub(/ +$/, "")
      printf "%s%s", (NR==1 ? fp : ci), (mode ? hl : dim)
      s = $0
      for (;;) {
        a = index(s, "\001"); b = index(s, "\002")
        if (a && (b == 0 || a < b)) { printf "%s%s%s", substr(s, 1, a-1), rs, hl;  s = substr(s, a+1); mode = 1 }
        else if (b)                 { printf "%s%s%s", substr(s, 1, b-1), rs, dim; s = substr(s, b+1); mode = 0 }
        else break
      }
      printf "%s%s\n", s, rs
    }'
}

cmd__preview() { # id — the branch's diverge story + its steering inputs, for the fzf preview pane
  init_state
  local id="${1:?}" name dir file state kids parent
  name=$(node_field "$id" name)
  dir=$(node_field "$id" dir)
  parent=$(node_field "$id" parent)
  file=$(session_file "$id" "$dir")
  if window_alive "$(node_field "$id" window)"; then
    case "$(state_of "$id")" in
      busy)    state=$'\033[32m●\033[0m busy' ;;
      waiting) state=$'\033[33m●\033[0m waiting' ;;
      *)       state='● idle' ;;
    esac
  else
    state=$'\033[2m○ closed\033[0m'
  fi
  kids=$(jq -r --arg id "$id" '[.[] | select(.parent==$id)] | length' "$TREE")
  printf '\033[1m%s\033[0m  %s' "$name" "$state"
  [[ -f "$file" ]] && printf ' · %s' "$(ago "$(stat -f %m "$file")")"
  if ((kids == 1)); then printf ' · 1 branch'
  elif ((kids > 1)); then printf ' · %s branches' "$kids"; fi
  printf '\n'
  if [[ -z "$parent" ]]; then
    printf '\n\033[2m%s\033[0m\n' "${dir/#$HOME/~}"
    return 0
  fi
  # the cascade: ancestors' diverge lines (dim) then our own, one relay step
  # per level — each was written once at branch time and never updated
  local chain="" n indent="" line printed=0 open
  local mk=$'\033[33m⑂\033[0m ' dm=$'\033[2m'
  n="$id"
  while [[ -n "$n" ]]; do chain="$n $chain"; n=$(node_field "$n" parent); done
  for n in $chain; do
    line=$(node_field "$n" diverge)
    [[ -n "$line" ]] || continue
    ((printed)) || { printf '\033[2m┄┄ story so far ┄┄┄┄┄┄┄┄┄\033[0m\n'; printed=1; }
    open=$dm; [[ "$n" == "$id" ]] && open=""
    pwrap "$indent$mk$open" "$indent  $open" $((${#indent} + 2)) "$line"
    indent+=" "
  done
  # the steering inputs: the highlight shown in place, the question verbatim
  local excerpt question
  excerpt=$(node_field "$id" excerpt)
  question=$(node_field "$id" question)
  [[ ${#excerpt} -gt 300 ]] && excerpt="${excerpt:0:300}…"
  if [[ -n "$excerpt$question" ]]; then
    printf '\033[2m┄┄ branched on ┄┄┄┄┄┄┄┄┄┄\033[0m\n'
    [[ -z "$excerpt" ]] || psnippet "$(node_field "$id" ctx_pre)" "$excerpt" "$(node_field "$id" ctx_post)"
    [[ -z "$question" ]] || pwrap $'\033[1;36m❯\033[0m \033[2masked\033[0m  ' '         ' 9 "$question"
  fi
  return 0
}

cmd_init() { # print tmux keybindings (absolute paths — PATH-proof)
  local self
  self=$(printf '%q' "$SELF")
  cat <<EOF

# >>> lemux >>>
# prefix + B          branch on the text you just copied (select + cmd-C first)
# prefix + T          open the branch tree navigator
# prefix + X          delete the current pane's branch (+ subtree)
bind-key B run-shell "$self _popup 78% 45% ask '#{pane_id}'"
bind-key T run-shell "$self _popup 85% 70% tree '#{pane_id}'"
bind-key X confirm-before -p "lemux: delete this branch and its subtree? (y/n)" "run-shell \"$self rm --pane '#{pane_id}'\""
# <<< lemux <<<
EOF
}

cmd_help() {
  cat <<'EOF'
lemux — tmux-native navigator for branched Claude Code sessions

Any claude session inside tmux is branchable — plain claude, --continue,
--resume, whatever. Its first branch (prefix+B) enrols it as a topic.

  lemux enable           install the claude hooks (once — install.sh does this)
  lemux tree <pane>      fzf navigator over that session's own side quests
  lemux ask <pane>       branch popup: copied text + a question
  lemux branch <pane>    fork the pane's session (--text <excerpt> --ask <q>)
  lemux jump <id>        focus a branch, reviving its window if closed
  lemux rm <name|id>     branch: delete it + its subtree (transcripts too)
                         topic name: untrack the topic — side-quest transcripts
                         are deleted, the root conversation is kept
  lemux init             print tmux keybindings (append to ~/.tmux.conf)

Typical flow: run claude in tmux → chat → select text with the mouse and hit
cmd-C → prefix+B, type your question → side quest opens as a fork with the full
parent context → prefix+T to jump around → prefix+X to throw a side quest away.
EOF
}

# ---------- dispatch ----------

case "${1:-help}" in
  enable)   shift; cmd_enable "$@" ;;
  branch)   shift; cmd_branch "$@" ;;
  ask)      shift; cmd_ask "$@" ;;
  tree)     shift; cmd_tree "$@" ;;
  jump)     shift; cmd_jump "$@" ;;
  rm)       shift; cmd_rm "$@" ;;
  init)     shift; cmd_init "$@" ;;
  _hello)   shift; cmd__hello "$@" ;;
  _list)    shift; cmd__list "$@" ;;
  _popup)   shift; cmd__popup "$@" ;;
  _type)    shift; cmd__type "$@" ;;
  _name)    shift; cmd__name "$@" ;;
  _state)   shift; cmd__state "$@" ;;
  _preview) shift; cmd__preview "$@" ;;
  _run)     shift; cmd__run "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $1 (try: lemux help)" ;;
esac
